# Create a NEW GitHub token. Do not reuse an exposed token.
# Fine-grained PAT permission: Contents = Read and write for laor-yt/laor-dubber-license-manager.
GITHUB_TOKEN=replace_with_new_token
GITHUB_OWNER=laor-yt
GITHUB_REPO=laor-dubber-license-manager
GITHUB_BRANCH=main
GITHUB_FILE_PATH=db.json

# Any password you choose. The web page asks for this before saving.
ADMIN_KEY=change_this_admin_key

PORT=3000

# Use * for simple testing, or lock it to your GitHub Pages URL in production.
# Example: ALLOWED_ORIGINS=https://laor-yt.github.io
ALLOWED_ORIGINS=*
